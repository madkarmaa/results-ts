{
    "compilerOptions": {
        // Environment
        "lib": ["ESNext", "DOM"],
        "types": ["bun", "node", "vitepress/client"],
        "target": "ESNext",
        "module": "ESNext",
        "moduleDetection": "force",

        // Module resolution
        "moduleResolution": "bundler",
        "verbatimModuleSyntax": true,
        "noEmit": true,

        // Type checks
        "strict": true,
        "skipLibCheck": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,

        // Additional checks
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noPropertyAccessFromIndexSignature": false
    },
    "include": ["src", "tests", "bench", "docs", "docs/.vitepress/**/*.ts"],
    "exclude": ["node_modules", "dist"]
}
